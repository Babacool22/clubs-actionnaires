# SQLite local (développement)
DATABASE_URL="file:./dev.db"

# URL publique de la newsletter "Le Club Actionnaire"
NEXT_PUBLIC_NEWSLETTER_URL=""

# Google Search Console API
# Propriété exacte dans GSC : "sc-domain:clubsactionnaires.fr" ou "https://clubsactionnaires.fr/"
GSC_SITE_URL="sc-domain:clubsactionnaires.fr"
GSC_DATA_STATE="all"

# Auth Google locale. Ne jamais committer le JSON credentials.
# Option recommandée : créer un service account, l'ajouter comme utilisateur GSC,
# puis pointer vers le fichier JSON téléchargé.
GOOGLE_APPLICATION_CREDENTIALS="./secrets/google-service-account.json"

# Alternative CI : service account via variables d'environnement.
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""

# GSC Bulk Data Export vers BigQuery
GSC_BQ_PROJECT_ID=""
GSC_BQ_DATASET=""
GSC_BQ_TABLE="searchdata_url_impression"

# Automatisation newsletter
NEWSLETTER_ADMIN_TOKEN=""
CRON_SECRET=""
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""
BEEHIIV_SEGMENT_ID=""
BEEHIIV_WELCOME_AUTOMATION_ID=""
BEEHIIV_API_BASE_URL="https://api.beehiiv.com/v2"
XAI_API_KEY=""
XAI_MODEL="grok-4.5"

# Supabase newsletter storage
SUPABASE_PROJECT_REF="bvbrytfuarjpmijrxsxg"
SUPABASE_URL="https://bvbrytfuarjpmijrxsxg.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_NEWSLETTER_TABLE="newsletter_issues"
